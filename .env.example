# Copia este archivo como ".env" y complétalo.
# En local, si NO pones DATABASE_URL, la app guarda en archivos (carpeta data/).

# Cadena de conexión de Postgres (Neon). Ejemplo de Neon:
# postgres://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Puerto (Render lo asigna solo; en local por defecto 3000)
PORT=3000

# Días que se conserva un torneo inactivo antes de borrarlo (limpieza automática)
ROOM_TTL_DAYS=7

# Pon "off" solo si tu Postgres NO usa SSL (Neon SÍ lo usa, así que déjalo vacío)
PGSSL=
